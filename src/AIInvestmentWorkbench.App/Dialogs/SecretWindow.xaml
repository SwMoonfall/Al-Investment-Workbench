<Window x:Class="AIInvestmentWorkbench.App.Dialogs.SecretWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="设置 API Key" Width="580" Height="350" WindowStartupLocation="CenterOwner" ResizeMode="NoResize" Background="{DynamicResource BackgroundBrush}" Foreground="{DynamicResource TextBrush}">
<StackPanel Margin="28"><TextBlock Text="API Key" Style="{StaticResource SectionTitle}"/><TextBlock x:Name="Endpoint" TextWrapping="Wrap" Margin="0,0,0,12"/><PasswordBox x:Name="Secret" MaxLength="4096" Padding="12" Background="{DynamicResource InputBrush}" Foreground="{DynamicResource TextBrush}" BorderBrush="{DynamicResource BorderBrush}"/><TextBlock Text="使用 Windows 当前用户加密保护。保存后清空输入，不显示完整密钥。" TextWrapping="Wrap" Margin="0,12"/><TextBlock x:Name="Status" Foreground="{DynamicResource ErrorBrush}" TextWrapping="Wrap"/><Button x:Name="Save" Content="加密保存" Click="OnSave" HorizontalAlignment="Right" Margin="0,12,0,0"/></StackPanel>
</Window>
