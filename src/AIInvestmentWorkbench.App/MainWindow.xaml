<Window x:Class="AIInvestmentWorkbench.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Style="{StaticResource {x:Type Window}}" Title="AI Investment Workbench · 1.0" Width="1380" Height="940" MinWidth="820" MinHeight="460" WindowStartupLocation="CenterScreen">
 <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"><Grid x:Name="WorkspaceLayout" Background="{DynamicResource BackgroundBrush}" MinWidth="1040" MinHeight="640"><Grid.ColumnDefinitions><ColumnDefinition Width="230"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <Border Background="{DynamicResource SidebarBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0" Padding="20,30"><DockPanel>
   <StackPanel DockPanel.Dock="Top" Margin="0,0,0,28"><Border Background="{DynamicResource AccentBrush}" CornerRadius="10" Width="44" Height="44" HorizontalAlignment="Left" Margin="0,0,0,16"><TextBlock Text="AI" Foreground="{DynamicResource AccentTextBrush}" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock Text="投资工作台" FontWeight="Bold" FontSize="23"/><TextBlock Text="INVESTMENT WORKBENCH" FontSize="10" Foreground="{DynamicResource MutedBrush}" Margin="0,8,0,0"/></StackPanel>
   <StackPanel DockPanel.Dock="Bottom"><TextBlock Text="{Binding WorkspaceLabel}" Style="{StaticResource Muted}"/><TextBlock Text="VERSION 1.0 / LOCAL WORKBENCH" FontSize="10" Foreground="{DynamicResource MutedBrush}" Margin="0,6,0,0"/></StackPanel>
   <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel><TextBlock Text="工作空间" FontSize="11" Foreground="{DynamicResource MutedBrush}" Margin="18,0,0,10"/><RadioButton Content="总览   Dashboard" GroupName="Nav" Command="{Binding NavigateCommand}" CommandParameter="Dashboard"><RadioButton.Style><Style TargetType="RadioButton" BasedOn="{StaticResource NavButton}"><Style.Triggers><DataTrigger Binding="{Binding Navigation.Current.Key}" Value="Dashboard"><Setter Property="IsChecked" Value="True"/></DataTrigger></Style.Triggers></Style></RadioButton.Style></RadioButton>
<RadioButton Content="组合   Portfolio" GroupName="Nav" Command="{Binding NavigateCommand}" CommandParameter="Portfolio"><RadioButton.Style><Style TargetType="RadioButton" BasedOn="{StaticResource NavButton}"><Style.Triggers><DataTrigger Binding="{Binding Navigation.Current.Key}" Value="Portfolio"><Setter Property="IsChecked" Value="True"/></DataTrigger></Style.Triggers></Style></RadioButton.Style></RadioButton>
<RadioButton Content="证券   Securities" GroupName="Nav" Command="{Binding NavigateCommand}" CommandParameter="Securities"><RadioButton.Style><Style TargetType="RadioButton" BasedOn="{StaticResource NavButton}"><Style.Triggers><DataTrigger Binding="{Binding Navigation.Current.Key}" Value="Securities"><Setter Property="IsChecked" Value="True"/></DataTrigger></Style.Triggers></Style></RadioButton.Style></RadioButton>
<RadioButton Content="观察   Watchlist" GroupName="Nav" Command="{Binding NavigateCommand}" CommandParameter="Watchlist"><RadioButton.Style><Style TargetType="RadioButton" BasedOn="{StaticResource NavButton}"><Style.Triggers><DataTrigger Binding="{Binding Navigation.Current.Key}" Value="Watchlist"><Setter Property="IsChecked" Value="True"/></DataTrigger></Style.Triggers></Style></RadioButton.Style></RadioButton>
<RadioButton Content="导入   CSV Import" GroupName="Nav" Command="{Binding NavigateCommand}" CommandParameter="Import"><RadioButton.Style><Style TargetType="RadioButton" BasedOn="{StaticResource NavButton}"><Style.Triggers><DataTrigger Binding="{Binding Navigation.Current.Key}" Value="Import"><Setter Property="IsChecked" Value="True"/></DataTrigger></Style.Triggers></Style></RadioButton.Style></RadioButton>
<RadioButton Content="风险   Risk" GroupName="Nav" Command="{Binding NavigateCommand}" CommandParameter="Risk"><RadioButton.Style><Style TargetType="RadioButton" BasedOn="{StaticResource NavButton}"><Style.Triggers><DataTrigger Binding="{Binding Navigation.Current.Key}" Value="Risk"><Setter Property="IsChecked" Value="True"/></DataTrigger></Style.Triggers></Style></RadioButton.Style></RadioButton><RadioButton Content="估值   Valuation" GroupName="Nav" Command="{Binding NavigateCommand}" CommandParameter="Valuation"><RadioButton.Style><Style TargetType="RadioButton" BasedOn="{StaticResource NavButton}"><Style.Triggers><DataTrigger Binding="{Binding Navigation.Current.Key}" Value="Valuation"><Setter Property="IsChecked" Value="True"/></DataTrigger></Style.Triggers></Style></RadioButton.Style></RadioButton><RadioButton Content="逻辑   Thesis" GroupName="Nav" Command="{Binding NavigateCommand}" CommandParameter="Thesis"><RadioButton.Style><Style TargetType="RadioButton" BasedOn="{StaticResource NavButton}"><Style.Triggers><DataTrigger Binding="{Binding Navigation.Current.Key}" Value="Thesis"><Setter Property="IsChecked" Value="True"/></DataTrigger></Style.Triggers></Style></RadioButton.Style></RadioButton><RadioButton Content="研究   Research" GroupName="Nav" Command="{Binding NavigateCommand}" CommandParameter="Research"><RadioButton.Style><Style TargetType="RadioButton" BasedOn="{StaticResource NavButton}"><Style.Triggers><DataTrigger Binding="{Binding Navigation.Current.Key}" Value="Research"><Setter Property="IsChecked" Value="True"/></DataTrigger></Style.Triggers></Style></RadioButton.Style></RadioButton><RadioButton Content="财务   Financial" GroupName="Nav" Command="{Binding NavigateCommand}" CommandParameter="Financial"><RadioButton.Style><Style TargetType="RadioButton" BasedOn="{StaticResource NavButton}"><Style.Triggers><DataTrigger Binding="{Binding Navigation.Current.Key}" Value="Financial"><Setter Property="IsChecked" Value="True"/></DataTrigger></Style.Triggers></Style></RadioButton.Style></RadioButton><RadioButton Content="搜索   Search" GroupName="Nav" Command="{Binding NavigateCommand}" CommandParameter="Search"><RadioButton.Style><Style TargetType="RadioButton" BasedOn="{StaticResource NavButton}"><Style.Triggers><DataTrigger Binding="{Binding Navigation.Current.Key}" Value="Search"><Setter Property="IsChecked" Value="True"/></DataTrigger></Style.Triggers></Style></RadioButton.Style></RadioButton><RadioButton Content="日志与复盘" GroupName="Nav" Command="{Binding NavigateCommand}" CommandParameter="Journal"><RadioButton.Style><Style TargetType="RadioButton" BasedOn="{StaticResource NavButton}"><Style.Triggers><DataTrigger Binding="{Binding Navigation.Current.Key}" Value="Journal"><Setter Property="IsChecked" Value="True"/></DataTrigger></Style.Triggers></Style></RadioButton.Style></RadioButton><RadioButton Content="AI 研究助理" GroupName="Nav" Command="{Binding NavigateCommand}" CommandParameter="AIResearch"><RadioButton.Style><Style TargetType="RadioButton" BasedOn="{StaticResource NavButton}"><Style.Triggers><DataTrigger Binding="{Binding Navigation.Current.Key}" Value="AIResearch"><Setter Property="IsChecked" Value="True"/></DataTrigger></Style.Triggers></Style></RadioButton.Style></RadioButton><RadioButton Content="设置   Settings" GroupName="Nav" Command="{Binding NavigateCommand}" CommandParameter="Settings"><RadioButton.Style><Style TargetType="RadioButton" BasedOn="{StaticResource NavButton}"><Style.Triggers><DataTrigger Binding="{Binding Navigation.Current.Key}" Value="Settings"><Setter Property="IsChecked" Value="True"/></DataTrigger></Style.Triggers></Style></RadioButton.Style></RadioButton></StackPanel></ScrollViewer>
  </DockPanel></Border>
  <Grid Grid.Column="1" Margin="30,26"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <Grid Margin="0,0,0,24"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="230"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{Binding Navigation.Current.Title}" FontSize="28" FontWeight="Bold"/><TextBlock Text="{Binding Navigation.Current.Subtitle}" Style="{StaticResource Muted}" Margin="0,8,20,0"/></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="当前账户（金额按本位币）" Style="{StaticResource Muted}" FontSize="11"/><ComboBox ItemsSource="{Binding Workspace.Accounts}" SelectedItem="{Binding Workspace.SelectedAccount}" DisplayMemberPath="Name" AutomationProperties.AutomationId="CurrentAccount"/></StackPanel></Grid>
   <ContentControl Grid.Row="1" Content="{Binding Navigation.Current}"/>
   <TextBlock Grid.Row="2" Text="AI 是研究助理，最终投资决策由你完成。AI 可在设置中启用；行情为手工更新。" Style="{StaticResource Muted}" FontSize="11" Margin="0,16,0,0"/>
  </Grid>
 </Grid>
</ScrollViewer></Window>













