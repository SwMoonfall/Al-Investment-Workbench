<UserControl x:Class="AIInvestmentWorkbench.App.Views.DashboardView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:views="clr-namespace:AIInvestmentWorkbench.App.Views">
 <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="0,0,12,0">
  <Border Background="{DynamicResource SelectionBrush}" CornerRadius="8" Padding="18" Margin="0,0,0,16"><Border.Style><Style TargetType="Border"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding HasAccount}" Value="False"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Border.Style><DockPanel><Button Content="创建账户" DockPanel.Dock="Right" Command="{Binding DataContext.NewAccountCommand, RelativeSource={RelativeSource AncestorType=Window}}"/><TextBlock Text="欢迎。创建账户后，开始记录你的投资组合。" VerticalAlignment="Center"/></DockPanel></Border>
  <Border Style="{StaticResource Card}" Padding="18"><StackPanel><TextBlock Text="需要复盘 · 全部研究证券" Style="{StaticResource SectionTitle}"/><views:ThesisReviewView DataContext="{Binding ThesisPanel}"/></StackPanel></Border><views:PortfolioMetrics/><views:JournalDashboardView DataContext="{Binding JournalPanel}"/>
  <TextBlock Text="{Binding Snapshot.ValuationNotice}" Style="{StaticResource Muted}" Margin="0,0,0,16"/>
  <Border Style="{StaticResource Card}" Padding="20"><StackPanel><TextBlock Text="资产配置 · 实际与目标" Style="{StaticResource SectionTitle}"/>
   <ItemsControl ItemsSource="{Binding Snapshot.Allocation}"><ItemsControl.ItemTemplate><DataTemplate><Grid Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="105"/><ColumnDefinition Width="*"/><ColumnDefinition Width="90"/><ColumnDefinition Width="110"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Name}"/><ProgressBar Grid.Column="1" Value="{Binding Weight}" Maximum="1" Height="12" Margin="8,0,20,0"/><TextBlock Grid.Column="2" Text="{Binding Weight, StringFormat=P1}"/><TextBlock Grid.Column="3" Text="{Binding TargetWeight, StringFormat=目标 {0:P0}}" Style="{StaticResource Muted}"/></Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
  </StackPanel></Border>
  <Border Style="{StaticResource Card}" Padding="20"><StackPanel><TextBlock Text="主要持仓 · Top 5" Style="{StaticResource SectionTitle}"/><DataGrid ItemsSource="{Binding TopPositions}" MaxHeight="280"><DataGrid.Columns><DataGridTextColumn Header="代码" Binding="{Binding Ticker}" Width="110"/><DataGridTextColumn Header="证券" Binding="{Binding CompanyName}" Width="*"/><DataGridTextColumn Header="市值" Binding="{Binding MarketValue, StringFormat=N2}" Width="140"/><DataGridTextColumn Header="权重" Binding="{Binding Weight, StringFormat=P2}" Width="100"/><DataGridTextColumn Header="浮盈亏" Binding="{Binding UnrealizedPnL, StringFormat=N2}" Width="120"/></DataGrid.Columns></DataGrid></StackPanel></Border>
  <Button Content="刷新总览" HorizontalAlignment="Right" Command="{Binding DataContext.RefreshCommand, RelativeSource={RelativeSource AncestorType=Window}}"/>
 </StackPanel></ScrollViewer>
</UserControl>


