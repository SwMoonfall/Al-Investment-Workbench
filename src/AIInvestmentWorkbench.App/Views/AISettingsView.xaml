<UserControl x:Class="AIInvestmentWorkbench.App.Views.AISettingsView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
<Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="AI 服务（可选）" Style="{StaticResource SectionTitle}"/><TextBlock Text="仅在你开始分析或测试连接时发送请求。请求会把所选研究快照发送至下面的服务地址；本地功能无需启用 AI。" Style="{StaticResource Muted}"/>
<WrapPanel Margin="0,16"><StackPanel Width="160" Margin="0,0,16,0"><TextBlock Text="Provider"/><ComboBox ItemsSource="{Binding Providers}" SelectedItem="{Binding Provider}"/></StackPanel><StackPanel Width="280" Margin="0,0,16,0"><TextBlock Text="Model（填入账户可用模型）"/><TextBox Text="{Binding Model, UpdateSourceTrigger=PropertyChanged}"/></StackPanel><StackPanel Width="140" Margin="0,0,16,0"><TextBlock Text="超时（秒，1–600）"/><TextBox Text="{Binding TimeoutSeconds}"/></StackPanel><StackPanel Width="170"><TextBlock Text="最大输出 tokens"/><TextBox Text="{Binding MaxOutputTokens}"/></StackPanel></WrapPanel>
<TextBlock Text="Base URL（可留空：官方服务；自定义地址必须支持 Responses 与 JSON Schema）"/><TextBox Text="{Binding BaseUrl, UpdateSourceTrigger=PropertyChanged}" Margin="0,8"/><TextBlock Text="地址变更后需单独设置密钥。密钥使用 Windows DPAPI 加密，不写入数据库。" Style="{StaticResource Muted}"/><TextBlock Text="{Binding KeyStatus}" Margin="0,12"/>
<WrapPanel><Button Content="设置 / 替换密钥" Command="{Binding SetKeyCommand}" Margin="0,0,12,12"/><Button Content="删除此地址密钥" Command="{Binding DeleteKeyCommand}" Margin="0,0,12,12"/><Button Content="保存 AI 设置" Command="{Binding SaveCommand}" Margin="0,0,12,12"/><Button Content="保存并测试连接" Command="{Binding TestCommand}" Margin="0,0,12,12"/></WrapPanel><TextBlock Text="{Binding Status}" TextWrapping="Wrap"/>
</StackPanel></Border></UserControl>
