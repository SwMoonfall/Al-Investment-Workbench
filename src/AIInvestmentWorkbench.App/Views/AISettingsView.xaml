<UserControl x:Class="AIInvestmentWorkbench.App.Views.AISettingsView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <UserControl.Resources><BooleanToVisibilityConverter x:Key="BoolVisibility"/></UserControl.Resources>
 <Grid>
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <TextBlock Text="{Binding ActiveModel}" Foreground="{DynamicResource AccentBrush}" FontWeight="SemiBold" Margin="0,0,0,14" TextWrapping="Wrap"/>
  <Grid Grid.Row="1" IsEnabled="{Binding CanEdit}">
   <Grid.ColumnDefinitions><ColumnDefinition Width="210"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <Border Style="{StaticResource Card}"><DockPanel>
    <StackPanel DockPanel.Dock="Top"><TextBlock Text="提供商" Style="{StaticResource SectionTitle}"/><Button Content="＋ 新增提供商" Command="{Binding NewCommand}" Margin="0,8"/><TextBlock Text="{Binding SourceEmpty}" Style="{StaticResource Muted}" Margin="0,0,0,12"/></StackPanel>
    <ListBox ItemsSource="{Binding Sources}" SelectedItem="{Binding SelectedSource}" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="提供商列表">
     <ListBox.ItemTemplate><DataTemplate><StackPanel Margin="4,10"><TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock Text="{Binding Type}" Style="{StaticResource Muted}" FontSize="11"/></StackPanel></DataTemplate></ListBox.ItemTemplate>
    </ListBox>
   </DockPanel></Border>
   <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
    <StackPanel>
     <Border Style="{StaticResource Card}"><StackPanel>
      <TextBlock Text="连接配置" Style="{StaticResource SectionTitle}"/>
      <TextBlock Text="{Binding DraftStatus}" Style="{StaticResource Muted}" Margin="0,0,0,12"/>
      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
       <StackPanel><TextBlock Text="名称"/><TextBox Text="{Binding SourceName, UpdateSourceTrigger=PropertyChanged}" MaxLength="100" AutomationProperties.Name="提供商名称"/></StackPanel>
       <StackPanel Grid.Column="2"><TextBlock Text="Provider 类型"/><ComboBox ItemsSource="{Binding ProviderOptions}" SelectedItem="{Binding ProviderType}" AutomationProperties.Name="提供商类型"/></StackPanel>
      </Grid>
      <TextBlock Text="Base URL" Margin="0,12,0,4"/><TextBox Text="{Binding BaseUrl, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Base URL"/>
      <TextBlock Text="{Binding DefaultUrl}" Style="{StaticResource Muted}" FontSize="11" Margin="0,4,0,10"/>
      <TextBlock Text="API Key"/><PasswordBox x:Name="Secret" PasswordChanged="OnPasswordChanged" MaxLength="4096" Padding="10" Background="{DynamicResource InputBrush}" Foreground="{DynamicResource TextBrush}" BorderBrush="{DynamicResource BorderBrush}" AutomationProperties.Name="API Key"/>
      <TextBlock Text="{Binding KeyStatus}" Style="{StaticResource Muted}" FontSize="11" Margin="0,4,0,8"/>
      <TextBlock Text="密钥由 Windows 加密保存，绑定当前提供商及地址。" Style="{StaticResource Muted}" FontSize="11"/>
      <Grid Margin="0,12,0,0" Visibility="{Binding IsOpenAI, Converter={StaticResource BoolVisibility}}"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="16"/><ColumnDefinition/></Grid.ColumnDefinitions>
       <StackPanel><TextBlock Text="Organization（可选）"/><TextBox Text="{Binding Organization, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
       <StackPanel Grid.Column="2"><TextBlock Text="Project（可选）"/><TextBox Text="{Binding Project, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
      </Grid>
      <StackPanel Margin="0,12,0,0" Visibility="{Binding IsAnthropic, Converter={StaticResource BoolVisibility}}"><TextBlock Text="Anthropic API Version"/><TextBox Text="{Binding ApiVersion, UpdateSourceTrigger=PropertyChanged}"/><TextBlock Text="原生 Messages API · x-api-key 身份验证" Style="{StaticResource Muted}" FontSize="11"/></StackPanel>
      <TextBlock Text="Google AI Studio API Key · 原生 GenAI generateContent API" Visibility="{Binding IsGoogle, Converter={StaticResource BoolVisibility}}" Style="{StaticResource Muted}" Margin="0,12,0,0"/>
      <StackPanel Margin="0,12,0,0" Visibility="{Binding IsCompatible, Converter={StaticResource BoolVisibility}}"><TextBlock Text="兼容协议"/><ComboBox ItemsSource="{Binding CompatibilityOptions}" SelectedItem="{Binding CompatibilityApi}"/><TextBlock Text="其他提供商可通过兼容层接入；结构化研究需服务支持 JSON Schema。" Style="{StaticResource Muted}"/></StackPanel>
      <WrapPanel Margin="0,12,0,8"><StackPanel Width="160" Margin="0,0,16,0"><TextBlock Text="超时（秒，1–600）"/><TextBox Text="{Binding TimeoutSeconds, UpdateSourceTrigger=PropertyChanged}"/></StackPanel><StackPanel Width="190"><TextBlock Text="最大输出 tokens"/><TextBox Text="{Binding MaxOutputTokens, UpdateSourceTrigger=PropertyChanged}"/></StackPanel></WrapPanel>
      <TextBlock Text="更换类型后，保存会移除原类型的模型关联；更换地址后需配置该地址的密钥。" Style="{StaticResource Muted}" FontSize="11" Margin="0,0,0,12"/>
      <WrapPanel><Button Content="保存配置" Command="{Binding SaveCommand}" Margin="0,0,8,8"/><Button Content="保存并获取模型" Command="{Binding SaveAndDiscoverCommand}" Margin="0,0,8,8"/><Button Content="放弃草稿" Command="{Binding DiscardCommand}" Margin="0,0,8,8"/><Button Content="删除密钥" Command="{Binding DeleteKeyCommand}" Margin="0,0,8,8"/><Button Content="删除提供商" Command="{Binding DeleteSourceCommand}" Margin="0,0,8,8"/></WrapPanel>
     </StackPanel></Border>
     <Border Style="{StaticResource Card}"><StackPanel>
      <DockPanel><Button Content="获取 / 刷新模型" Command="{Binding DiscoverCommand}" DockPanel.Dock="Right"/><TextBlock Text="模型列表" Style="{StaticResource SectionTitle}"/></DockPanel>
      <TextBlock Text="{Binding ModelSummary}" Style="{StaticResource Muted}" Margin="0,8"/>
      <DataGrid ItemsSource="{Binding Models}" SelectedItem="{Binding SelectedModel}" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single" Height="240" CanUserAddRows="False" AutomationProperties.Name="模型列表">
       <DataGrid.Columns><DataGridTextColumn Header="模型 ID" Binding="{Binding ModelId}" Width="*"/><DataGridTextColumn Header="来源" Binding="{Binding Origin}" Width="90"/><DataGridTextColumn Header="状态" Binding="{Binding State}" Width="90"/></DataGrid.Columns>
      </DataGrid>
      <WrapPanel Margin="0,12,0,0"><Button Content="添加 / 启用" Command="{Binding AddModelCommand}" Margin="0,0,8,8"/><Button Content="切换启用 / 禁用" Command="{Binding ToggleModelCommand}" Margin="0,0,8,8"/><Button Content="移除" Command="{Binding RemoveModelCommand}" Margin="0,0,8,8"/><Button Content="设为当前模型" Command="{Binding UseModelCommand}" Margin="0,0,8,8"/><Button Content="调用测试" Command="{Binding TestModelCommand}" Margin="0,0,8,8"/></WrapPanel>
      <TextBlock Text="自定义模型 ID" Margin="0,8,0,4"/><DockPanel><Button Content="添加自定义模型" Command="{Binding AddCustomCommand}" DockPanel.Dock="Right" Margin="8,0,0,0"/><TextBox Text="{Binding CustomModelId, UpdateSourceTrigger=PropertyChanged}" MaxLength="150" AutomationProperties.Name="自定义模型 ID"/></DockPanel>
      <TextBlock Text="调用测试发送最小请求，可能产生 API 费用。设置当前模型后，研究助理将使用该模型。" Style="{StaticResource Muted}" FontSize="11" Margin="0,12,0,0"/>
     </StackPanel></Border>
    </StackPanel>
   </ScrollViewer>
  </Grid>
  <StackPanel Grid.Row="2" Margin="0,10,0,0"><ProgressBar IsIndeterminate="True" Height="3" Visibility="{Binding IsBusy, Converter={StaticResource BoolVisibility}}"/><DockPanel Margin="0,8,0,0"><Button Content="取消请求" Command="{Binding CancelCommand}" DockPanel.Dock="Right" Visibility="{Binding IsBusy, Converter={StaticResource BoolVisibility}}"/><TextBlock Text="{Binding Status}" TextWrapping="Wrap" VerticalAlignment="Center" AutomationProperties.LiveSetting="Polite"/></DockPanel></StackPanel>
 </Grid>
</UserControl>
