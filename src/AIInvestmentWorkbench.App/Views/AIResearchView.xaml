<UserControl x:Class="AIInvestmentWorkbench.App.Views.AIResearchView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
<Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
<StackPanel><WrapPanel IsEnabled="{Binding CanEdit}"><TextBlock Text="证券" VerticalAlignment="Center" Margin="0,0,10,12"/><ComboBox ItemsSource="{Binding Securities}" SelectedItem="{Binding SelectedSecurity}" DisplayMemberPath="Name" Width="220" Margin="0,0,16,12"/><ComboBox ItemsSource="{Binding Templates}" SelectedItem="{Binding SelectedTemplate}" DisplayMemberPath="Name" Width="265" Margin="0,0,16,12"/><Button Content="刷新 / 历史" Command="{Binding RefreshCommand}" Margin="0,0,12,12"/></WrapPanel>
<WrapPanel><Button Content="预览上下文" Command="{Binding PreviewCommand}" IsEnabled="{Binding CanEdit}" Margin="0,0,10,12"/><Button Content="开始单项分析" Command="{Binding RunCommand}" IsEnabled="{Binding CanEdit}" Margin="0,0,10,12"/><Button Content="完整公司研究 · 10 步" Command="{Binding FullCommand}" IsEnabled="{Binding CanEdit}" Margin="0,0,10,12"/><Button Content="取消" Command="{Binding CancelCommand}" IsEnabled="{Binding Busy}" Margin="0,0,10,12"/></WrapPanel>
<TextBlock Text="开始后将发送任务所需的选定资料到 Settings 配置的 AI 服务，可能产生费用。完整研究调用 10 次；所有结果自动保存。" Style="{StaticResource Muted}" Margin="0,0,0,12"/></StackPanel>
<TabControl Grid.Row="1">
<TabItem Header="任务与上下文"><Grid Margin="16"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="110"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><TextBlock Text="本次补充材料（可选，最多 6000 字符；Journal Review 会结合当前账户日志；精确日期范围在日志与复盘页选择）"/><TextBox Grid.Row="1" Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanEdit}" MaxLength="6000" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Margin="0,8"/><TextBlock Grid.Row="2" Text="上下文预览（单项任务）；执行时会重新读取最新资料并保存精确快照。" Margin="0,8"/><TextBox Grid.Row="3" Text="{Binding Preview, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/></Grid></TabItem>
<TabItem Header="提示词"><DockPanel Margin="16"><WrapPanel DockPanel.Dock="Top" IsEnabled="{Binding CanEdit}"><Button Content="修改" Command="{Binding EditCommand}" Margin="0,0,10,12"/><Button Content="复制为新模板" Command="{Binding CopyCommand}" Margin="0,0,10,12"/><Button Content="恢复默认" Command="{Binding RestoreCommand}" Margin="0,0,10,12"/></WrapPanel><TextBox Text="{Binding SelectedTemplate.Body, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/></DockPanel></TabItem>
<TabItem Header="结果与审计"><Grid Margin="16"><Grid.RowDefinitions><RowDefinition Height="145"/><RowDefinition Height="*"/></Grid.RowDefinitions><DataGrid ItemsSource="{Binding Analyses}" SelectedItem="{Binding SelectedAnalysis}"><DataGrid.Columns><DataGridTextColumn Header="创建时间" Binding="{Binding CreatedAt, StringFormat=yyyy-MM-dd HH:mm}" Width="155"/><DataGridTextColumn Header="任务" Binding="{Binding AnalysisType}" Width="*"/><DataGridTextColumn Header="状态" Binding="{Binding Status}" Width="130"/><DataGridTextColumn Header="模型" Binding="{Binding Model}" Width="140"/></DataGrid.Columns></DataGrid><TabControl Grid.Row="1" Margin="0,12,0,0"><TabItem Header="分类结果 · 待核实"><TextBox Text="{Binding ResultText, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/></TabItem><TabItem Header="原始响应"><TextBox Text="{Binding SelectedAnalysis.RawOutput, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/></TabItem><TabItem Header="完整审计"><TextBox Text="{Binding AuditText, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/></TabItem></TabControl></Grid></TabItem>
<TabItem Header="研究报告"><DockPanel Margin="16"><StackPanel DockPanel.Dock="Top"><WrapPanel><Button Content="导出所选报告" Command="{Binding ExportCommand}" Margin="0,0,12,12"/><TextBlock Text="已完成章节自动保存；中断报告明确标注不完整。" VerticalAlignment="Center"/></WrapPanel><ComboBox ItemsSource="{Binding Reports}" SelectedItem="{Binding SelectedReport}" DisplayMemberPath="Title" Margin="0,0,0,12"/><TextBlock Text="{Binding SelectedReport.Status}" Margin="0,0,0,8"/></StackPanel><TextBox Text="{Binding SelectedReport.ReportMarkdown, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/></DockPanel></TabItem>
</TabControl><StackPanel Grid.Row="2" Margin="0,12,0,0"><ProgressBar Minimum="0" Maximum="10" Value="{Binding ProgressValue, Mode=OneWay}" Height="5"/><TextBlock Text="{Binding Status}" TextWrapping="Wrap" Margin="0,8,0,0"/></StackPanel></Grid></UserControl>

