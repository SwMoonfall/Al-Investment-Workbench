<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="AIInvestmentWorkbench.App.Views.SearchView"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="260"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
<DockPanel><Button DockPanel.Dock="Right" Content="搜索本地资料" Command="{Binding SearchCommand}" Margin="12,0,0,0"/><TextBox Text="{Binding Query, UpdateSourceTrigger=PropertyChanged}" ToolTip="输入至少两个字符"><TextBox.InputBindings><KeyBinding Key="Enter" Command="{Binding SearchCommand}"/></TextBox.InputBindings></TextBox></DockPanel>
<TextBlock Grid.Row="1" Text="{Binding Status}" Style="{StaticResource Muted}" Margin="0,12"/>
<DataGrid Grid.Row="2" ItemsSource="{Binding Results}" SelectedItem="{Binding Selected}"><DataGrid.Columns><DataGridTextColumn Header="类型" Binding="{Binding Kind}" Width="190"/><DataGridTextColumn Header="证券" Binding="{Binding Security}" Width="230"/><DataGridTextColumn Header="标题 / 章节" Binding="{Binding Title}" Width="*"/></DataGrid.Columns></DataGrid>
<WrapPanel Grid.Row="3" Margin="0,16"><Button Content="打开公司研究" Command="{Binding OpenResearchCommand}" Margin="0,0,12,0"/><Button Content="打开财务分析" Command="{Binding OpenFinancialCommand}"/></WrapPanel>
<TextBox Grid.Row="4" Text="{Binding Selected.Content, Mode=OneWay}" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/></Grid></UserControl>
