<UserControl x:Class="AIInvestmentWorkbench.App.Views.PortfolioMetrics" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <UniformGrid Columns="3">
  <Border Style="{StaticResource Card}" Padding="18" Margin="0,0,10,12"><StackPanel><TextBlock Text="总资产" Style="{StaticResource Muted}"/><TextBlock Text="{Binding Snapshot.TotalAssets, StringFormat=N2}" FontSize="26" FontWeight="SemiBold"/><TextBlock Text="{Binding Snapshot.Account.BaseCurrency}" Style="{StaticResource Muted}" FontSize="11"/></StackPanel></Border>
  <Border Style="{StaticResource Card}" Padding="18" Margin="0,0,10,12"><StackPanel><TextBlock Text="现金" Style="{StaticResource Muted}"/><TextBlock Text="{Binding Snapshot.Cash, StringFormat=N2}" FontSize="26"/><TextBlock Text="交易驱动余额" Style="{StaticResource Muted}" FontSize="11"/></StackPanel></Border>
  <Border Style="{StaticResource Card}" Padding="18" Margin="0,0,0,12"><StackPanel><TextBlock Text="证券市值" Style="{StaticResource Muted}"/><TextBlock Text="{Binding Snapshot.InvestedAssets, StringFormat=N2}" FontSize="26"/><TextBlock Text="手工报价 / 成本暂估" Style="{StaticResource Muted}" FontSize="11"/></StackPanel></Border>
  <Border Style="{StaticResource Card}" Padding="18" Margin="0,0,10,16"><StackPanel><TextBlock Text="浮盈亏（未实现）" Style="{StaticResource Muted}"/><TextBlock Text="{Binding Snapshot.UnrealizedPnL, StringFormat=N2}" FontSize="26"/></StackPanel></Border>
  <Border Style="{StaticResource Card}" Padding="18" Margin="0,0,10,16"><StackPanel><TextBlock Text="持仓资产数" Style="{StaticResource Muted}"/><TextBlock Text="{Binding Snapshot.PositionCount}" FontSize="26"/></StackPanel></Border>
  <Border Style="{StaticResource Card}" Padding="18" Margin="0,0,0,16"><StackPanel><TextBlock Text="全局观察清单" Style="{StaticResource Muted}"/><TextBlock Text="{Binding Snapshot.WatchlistCount}" FontSize="26"/></StackPanel></Border>
 </UniformGrid>
</UserControl>
