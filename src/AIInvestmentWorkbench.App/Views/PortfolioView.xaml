<UserControl x:Class="AIInvestmentWorkbench.App.Views.PortfolioView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:views="clr-namespace:AIInvestmentWorkbench.App.Views">
 <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="0,0,12,0">
  <WrapPanel Margin="0,0,0,16"><Button Content="＋ 新增交易" Command="{Binding AddTransactionCommand}" Margin="0,0,10,8"/><Button Content="新增账户" Command="{Binding NewAccountCommand}" Margin="0,0,10,8"/><Button Content="账户设置" Command="{Binding EditAccountCommand}" Margin="0,0,10,8"/><Button Content="刷新" Command="{Binding DataContext.RefreshCommand, RelativeSource={RelativeSource AncestorType=Window}}" Margin="0,0,0,8"/></WrapPanel>
  <Border Style="{StaticResource Card}" Padding="18"><StackPanel><TextBlock Text="持仓证券 · Thesis 状态与复盘" Style="{StaticResource SectionTitle}"/><views:ThesisReviewView DataContext="{Binding ThesisPanel}"/></StackPanel></Border><views:PortfolioMetrics/><TextBlock Text="{Binding Snapshot.ValuationNotice}" Style="{StaticResource Muted}" Margin="0,0,0,16"/>
  <Border Style="{StaticResource Card}" Padding="18"><StackPanel><TextBlock Text="持仓明细" Style="{StaticResource SectionTitle}"/>
   <WrapPanel Margin="0,0,0,12"><TextBox Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" Width="190" ToolTip="搜索代码或名称" Margin="0,0,10,8"/><ComboBox ItemsSource="{Binding Filters}" SelectedItem="{Binding Filter}" Width="135" Margin="0,0,10,8"/><Button Content="编辑价格 / 权重" Command="{Binding EditPriceCommand}" Margin="0,0,10,8"/><Button Content="风险 / 决策" Command="{Binding RiskCommand}" Margin="0,0,10,8"/><Button Content="查看证券" Command="{Binding ViewSecurityCommand}" Margin="0,0,0,8"/></WrapPanel>
   <DataGrid ItemsSource="{Binding Holdings}" SelectedItem="{Binding SelectedHolding}" Height="260" SelectionMode="Single" AutomationProperties.AutomationId="HoldingsGrid"><DataGrid.Columns>
    <DataGridTextColumn Header="代码" Binding="{Binding Ticker}" Width="90"/><DataGridTextColumn Header="证券" Binding="{Binding CompanyName}" Width="130"/><DataGridTextColumn Header="数量" Binding="{Binding Quantity}" Width="90"/><DataGridTextColumn Header="平均成本" Binding="{Binding AverageCost, StringFormat=N4}" Width="105"/>
    <DataGridTextColumn Header="市值" Binding="{Binding MarketValue, StringFormat=N2}" Width="120"/><DataGridTextColumn Header="权重" Binding="{Binding Weight, StringFormat=P2}" Width="90"/><DataGridTextColumn Header="浮盈亏" Binding="{Binding UnrealizedPnL, StringFormat=N2}" Width="110"/><DataGridTextColumn Header="浮盈亏 %" Binding="{Binding UnrealizedPnLPercent, StringFormat=P2}" Width="110"/>
    <DataGridTextColumn Header="最新价" Binding="{Binding LatestPrice, StringFormat=N4}" Width="95"/><DataGridTextColumn Header="价格日期" Binding="{Binding PriceDate, StringFormat=yyyy-MM-dd}" Width="110"/><DataGridTextColumn Header="价格来源" Binding="{Binding PriceSource}" Width="100"/><DataGridTextColumn Header="目标" Binding="{Binding TargetWeight, StringFormat=P1}" Width="80"/><DataGridTextColumn Header="上限" Binding="{Binding MaxWeight, StringFormat=P1}" Width="80"/><DataGridTextColumn Header="状态" Binding="{Binding LimitStatus}" Width="110"/><DataGridTextColumn Header="分类" Binding="{Binding Bucket}" Width="110"/>
   </DataGrid.Columns></DataGrid><TextBlock Text="暂无持仓。请先在证券库新增证券，再录入买入交易。" Margin="0,12,0,0"><TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource Muted}"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Snapshot.PositionCount}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
  </StackPanel></Border>
  <Border Style="{StaticResource Card}" Padding="18"><StackPanel><TextBlock Text="交易历史" Style="{StaticResource SectionTitle}"/><TextBlock Text="按日期、录入顺序计算；历史记录独立保存。当前版本仅追加，不提供历史修改或删除。" Style="{StaticResource Muted}" Margin="0,0,0,12"/>
   <DataGrid ItemsSource="{Binding Snapshot.Transactions}" Height="230"><DataGrid.Columns><DataGridTextColumn Header="日期" Binding="{Binding Date, StringFormat=yyyy-MM-dd}" Width="110"/><DataGridTextColumn Header="顺序" Binding="{Binding Sequence}" Width="65"/><DataGridTextColumn Header="类型" Binding="{Binding Type}" Width="90"/><DataGridTextColumn Header="代码" Binding="{Binding Ticker}" Width="90"/><DataGridTextColumn Header="数量" Binding="{Binding Quantity}" Width="85"/><DataGridTextColumn Header="单价" Binding="{Binding Price}" Width="90"/><DataGridTextColumn Header="现金金额" Binding="{Binding Amount, StringFormat=N2}" Width="110"/><DataGridTextColumn Header="费用" Binding="{Binding Fees}" Width="80"/><DataGridTextColumn Header="币种" Binding="{Binding Currency}" Width="65"/><DataGridTextColumn Header="备注" Binding="{Binding Notes}" Width="220"/></DataGrid.Columns></DataGrid>
  </StackPanel></Border>
 </StackPanel></ScrollViewer>
</UserControl>


