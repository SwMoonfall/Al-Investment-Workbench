<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="AIInvestmentWorkbench.App.Views.ResearchView">
<Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
<DockPanel Margin="0,0,0,16"><Button DockPanel.Dock="Right" Content="刷新资料" Command="{Binding ReloadCommand}" Margin="12,0,0,0"/><TextBlock Text="研究证券" VerticalAlignment="Center" Margin="0,0,16,0"/><ComboBox ItemsSource="{Binding Securities}" SelectedItem="{Binding SelectedSecurity}" DisplayMemberPath="Name" MinWidth="250"/></DockPanel>
<TabControl Grid.Row="1" IsEnabled="{Binding HasSecurity}">
<TabItem Header="公司研究"><Grid Margin="16"><Grid.ColumnDefinitions><ColumnDefinition Width="225"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
<ListBox ItemsSource="{Binding Sections}" SelectedItem="{Binding SelectedSection}" DisplayMemberPath="Title" Margin="0,0,16,0"/>
<DockPanel Grid.Column="1"><StackPanel DockPanel.Dock="Top"><TextBlock Text="{Binding SelectedSection.Title}" Style="{StaticResource SectionTitle}"/><Button Content="编辑此章节" Command="{Binding EditSectionCommand}" HorizontalAlignment="Left" Margin="0,0,0,16"/></StackPanel><TextBox Text="{Binding SelectedSection.Body, Mode=OneWay}" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/></DockPanel></Grid></TabItem>
<TabItem Header="来源与文件"><Grid Margin="16"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="210"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
<WrapPanel><Button Content="新增来源" Command="{Binding AddSourceCommand}" Margin="0,0,10,12"/><Button Content="导入 TXT / Markdown / CSV / PDF" Command="{Binding ImportSourceCommand}" Margin="0,0,10,12"/><Button Content="编辑来源" Command="{Binding EditSourceCommand}" Margin="0,0,10,12"/><Button Content="删除来源" Command="{Binding DeleteSourceCommand}" Margin="0,0,10,12"/></WrapPanel>
<DataGrid Grid.Row="1" ItemsSource="{Binding Sources}" SelectedItem="{Binding SelectedSource}"><DataGrid.Columns><DataGridTextColumn Header="等级" Binding="{Binding ReliabilityLevel}" Width="60"/><DataGridTextColumn Header="标题" Binding="{Binding Title}" Width="*"/><DataGridTextColumn Header="类型" Binding="{Binding SourceType}" Width="145"/><DataGridTextColumn Header="发布者" Binding="{Binding Publisher}" Width="130"/><DataGridTextColumn Header="发布日期" Binding="{Binding PublishedDate, StringFormat=yyyy-MM-dd}" Width="110"/></DataGrid.Columns></DataGrid>
<StackPanel Grid.Row="2" Margin="0,12"><TextBlock Text="{Binding SelectedSource.Title}" FontWeight="Bold"/><TextBlock Text="{Binding SelectedSource.LocalFilePath}" Style="{StaticResource Muted}"/><TextBlock Text="{Binding SelectedSource.Url}" Style="{StaticResource Muted}"/><TextBlock Text="{Binding SelectedSource.Notes}"/></StackPanel>
<TextBox Grid.Row="3" Text="{Binding SelectedSource.ExtractedText, Mode=OneWay}" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/></Grid></TabItem>
<TabItem Header="研究评分"><Grid Margin="16"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="270"/><RowDefinition Height="*"/></Grid.RowDefinitions>
<TextBlock Text="{Binding ScoreSummary}" Margin="0,0,0,16"/>
<WrapPanel Grid.Row="1"><Button Content="编辑所选评分" Command="{Binding EditScoreCommand}" Margin="0,0,12,12"/><Button Content="调整七项权重" Command="{Binding EditWeightsCommand}" Margin="0,0,12,12"/></WrapPanel>
<DataGrid Grid.Row="2" ItemsSource="{Binding Scores}" SelectedItem="{Binding SelectedScore}"><DataGrid.Columns><DataGridTextColumn Header="维度" Binding="{Binding Dimension}" Width="*"/><DataGridTextColumn Header="权重 %" Binding="{Binding Weight}" Width="80"/><DataGridTextColumn Header="当前分数" Binding="{Binding EffectiveScore}" Width="90"/><DataGridTextColumn Header="分数来源" Binding="{Binding ScoreOrigin}" Width="195"/><DataGridTextColumn Header="更新时间" Binding="{Binding UpdatedAt, StringFormat=yyyy-MM-dd HH:mm}" Width="150"/></DataGrid.Columns></DataGrid>
<ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto" Margin="0,16,0,0"><StackPanel><TextBlock Text="理由" FontWeight="Bold"/><TextBlock Text="{Binding SelectedScore.Reason}" Margin="0,8,0,16"/><TextBlock Text="证据" FontWeight="Bold"/><TextBlock Text="{Binding SelectedScore.Evidence}" Margin="0,8,0,0"/></StackPanel></ScrollViewer></Grid></TabItem>
</TabControl><TextBlock Grid.Row="2" Text="{Binding Status}" Style="{StaticResource Muted}" Margin="0,12,0,0"/></Grid></UserControl>
