<UserControl x:Class="AIInvestmentWorkbench.App.Views.JournalDashboardView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"><Border Style="{StaticResource Card}"><StackPanel><DockPanel><Button Content="打开日志与复盘" Command="{Binding OpenCommand}" DockPanel.Dock="Right"/><TextBlock Text="投资行为与季度复盘" Style="{StaticResource SectionTitle}"/></DockPanel><TextBlock Text="{Binding Summary}" Margin="0,12"/><ListBox ItemsSource="{Binding Due}" MaxHeight="240" ScrollViewer.CanContentScroll="True" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"><ListBox.ItemTemplate><DataTemplate><Button Content="{Binding Label}" HorizontalAlignment="Left" Command="{Binding DataContext.OpenCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Margin="0,0,0,8"/></DataTemplate></ListBox.ItemTemplate></ListBox><TextBlock Text="{Binding Warnings}" Foreground="{DynamicResource ThesisAmberBrush}" Margin="0,8"/><Grid Margin="0,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel Margin="0,0,20,0"><TextBlock Text="最近 Journal" FontWeight="Bold" Margin="0,0,0,8"/><TextBlock Text="{Binding RecentJournal}" TextWrapping="Wrap"/></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="最近 AI Review（独立分析）" FontWeight="Bold" Margin="0,0,0,8"/><TextBlock Text="{Binding RecentAI}" TextWrapping="Wrap"/></StackPanel></Grid></StackPanel></Border></UserControl>

