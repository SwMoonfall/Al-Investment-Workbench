<UserControl x:Class="AIInvestmentWorkbench.App.Views.ImportView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="0,0,12,0" IsEnabled="{Binding IsIdle}">
  <Border Style="{StaticResource Card}" Padding="18"><StackPanel><TextBlock Text="{Binding Status}" Style="{StaticResource SectionTitle}"/><WrapPanel><ComboBox ItemsSource="{Binding Kinds}" SelectedItem="{Binding Kind}" Width="180" Margin="0,0,12,12"/><Button Content="选择 CSV" Command="{Binding SelectFileCommand}" Margin="0,0,12,12"/><TextBlock Text="UTF-8 · 最多 5 MB / 10000 条" Style="{StaticResource Muted}" Margin="0,6,0,0"/></WrapPanel><TextBlock Text="{Binding FileName}" Style="{StaticResource Muted}"/><TextBlock Text="{Binding Hint}" Margin="0,12,0,0"/></StackPanel></Border>
  <Border Style="{StaticResource Card}" Padding="18"><StackPanel><TextBlock Text="预览（前 100 条）" Style="{StaticResource SectionTitle}"/><DataGrid ItemsSource="{Binding Preview}" AutoGenerateColumns="True" Height="170"/></StackPanel></Border>
  <Border Style="{StaticResource Card}" Padding="18"><StackPanel><TextBlock Text="字段映射 · * 必填" Style="{StaticResource SectionTitle}"/><ItemsControl ItemsSource="{Binding Mappings}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="2"/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><Grid Margin="0,0,18,12"><Grid.ColumnDefinitions><ColumnDefinition Width="130"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Label}" VerticalAlignment="Center"/><ComboBox Grid.Column="1" ItemsSource="{Binding Headers}" SelectedItem="{Binding Header}" MinHeight="36"/></Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></Border>
  <WrapPanel Margin="0,0,0,12"><Button Content="验证整批数据" Command="{Binding ValidateCommand}" Margin="0,0,12,8"/><Button Content="确认导入" Command="{Binding ImportCommand}" IsEnabled="{Binding CanImport}" Margin="0,0,12,8"/><Button Content="保存错误 / 结果报告" Command="{Binding SaveReportCommand}" Margin="0,0,0,8"/></WrapPanel><TextBox Text="{Binding Report, Mode=OneWay}" IsReadOnly="True" MinHeight="100" AcceptsReturn="True"/>
 </StackPanel></ScrollViewer>
</UserControl>

