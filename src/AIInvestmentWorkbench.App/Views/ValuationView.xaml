<UserControl x:Class="AIInvestmentWorkbench.App.Views.ValuationView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
  <WrapPanel><ComboBox Width="230" ItemsSource="{Binding Securities}" SelectedItem="{Binding SelectedSecurity}" DisplayMemberPath="Symbol"/><ComboBox Width="230" ItemsSource="{Binding Models}" SelectedItem="{Binding SelectedModel}" DisplayMemberPath="Name"/><Button Content="新建模型" Command="{Binding CreateCommand}"/><Button Content="刷新" Command="{Binding ReloadCommand}"/></WrapPanel>
  <Border Style="{StaticResource Card}" Padding="16" Margin="0,12,0,12"><StackPanel><TextBlock Text="{Binding ActualsText}" TextWrapping="Wrap" LineHeight="22"/><WrapPanel Margin="0,8,0,0" IsEnabled="{Binding HasModel}"><Button Content="编辑基础数据" Command="{Binding ActualsCommand}"/><Button Content="删除模型" Command="{Binding DeleteCommand}"/></WrapPanel></StackPanel></Border>
  <TextBlock Text="Bear / Base / Bull · 同口径比较" Style="{StaticResource SectionTitle}"/>
  <TextBlock Text="新建时三情景相同，编辑后比较。金额和股数均为完整单位。反推值标为 Calculated，其余输入标为 Actual / Assumption。" Style="{StaticResource Muted}" Margin="0,4,0,10" TextWrapping="Wrap"/>
  <WrapPanel IsEnabled="{Binding HasModel}"><Button Content="编辑 Bear" Command="{Binding EditCommand}" CommandParameter="Bear"/><Button Content="编辑 Base" Command="{Binding EditCommand}" CommandParameter="Base"/><Button Content="编辑 Bull" Command="{Binding EditCommand}" CommandParameter="Bull"/><Button Content="Base → Bear" Command="{Binding CopyCommand}" CommandParameter="Bear"/><Button Content="Base → Bull" Command="{Binding CopyCommand}" CommandParameter="Bull"/></WrapPanel>
  <DataGrid ItemsSource="{Binding Comparison}" AutoGenerateColumns="False" Margin="0,10,0,16" MinHeight="260" RowHeight="32" MinRowHeight="32"><DataGrid.Resources><Style TargetType="DataGridCell" BasedOn="{StaticResource {x:Type DataGridCell}}"><Setter Property="Padding" Value="12,4"/></Style></DataGrid.Resources><DataGrid.Columns><DataGridTextColumn Header="类别 / 指标" Binding="{Binding Label}" Width="2*"/><DataGridTextColumn Header="Bear · 悲观" Binding="{Binding Bear}" Width="*"/><DataGridTextColumn Header="Base · 基准" Binding="{Binding Base}" Width="*"/><DataGridTextColumn Header="Bull · 乐观" Binding="{Binding Bull}" Width="*"/></DataGrid.Columns></DataGrid>
  <WrapPanel><TextBlock Text="计算明细" Style="{StaticResource SectionTitle}" VerticalAlignment="Center" Margin="0,0,18,0"/><ComboBox Width="160" ItemsSource="{Binding Kinds}" SelectedItem="{Binding SelectedKind}"/></WrapPanel>
  <ItemsControl ItemsSource="{Binding Details}" Margin="0,10,0,16"><ItemsControl.ItemTemplate><DataTemplate><Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="6,9"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="240"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Label}" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap"/><TextBlock Grid.Column="1" Text="{Binding Value}" TextWrapping="Wrap"/></Grid></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
  <TextBlock Text="DCF · 年度现金流（空表表示当前模型无年度预测）" Style="{StaticResource Muted}"/>
  <DataGrid ItemsSource="{Binding Forecast}" AutoGenerateColumns="False" MaxHeight="350" MinHeight="80" Margin="0,8,0,0"><DataGrid.Columns>
   <DataGridTextColumn Header="年" Binding="{Binding Year}"/><DataGridTextColumn Header="收入" Binding="{Binding Revenue,StringFormat=N2}"/><DataGridTextColumn Header="EBIT" Binding="{Binding OperatingIncome,StringFormat=N2}"/><DataGridTextColumn Header="税" Binding="{Binding Tax,StringFormat=N2}"/><DataGridTextColumn Header="折旧" Binding="{Binding Depreciation,StringFormat=N2}"/><DataGridTextColumn Header="Capex" Binding="{Binding Capex,StringFormat=N2}"/><DataGridTextColumn Header="ΔNWC" Binding="{Binding ChangeWorkingCapital,StringFormat=N2}"/><DataGridTextColumn Header="FCFF" Binding="{Binding FCF,StringFormat=N2}"/><DataGridTextColumn Header="折现因子" Binding="{Binding DiscountFactor,StringFormat=N6}"/><DataGridTextColumn Header="现值" Binding="{Binding PresentValue,StringFormat=N2}"/>
  </DataGrid.Columns></DataGrid>
 </StackPanel></ScrollViewer>
</UserControl>
