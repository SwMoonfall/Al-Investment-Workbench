<UserControl x:Class="AIInvestmentWorkbench.App.Views.ThesisView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
<Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
<DockPanel Margin="0,0,0,12"><Button DockPanel.Dock="Right" Content="刷新" Command="{Binding ReloadCommand}" Margin="10,0,0,0"/><Button DockPanel.Dock="Right" Content="新建 Thesis" Command="{Binding CreateCommand}" Margin="10,0,0,0"/><TextBlock Text="证券" VerticalAlignment="Center" Margin="0,0,12,0"/><ComboBox ItemsSource="{Binding Securities}" SelectedItem="{Binding SelectedSecurity}" DisplayMemberPath="Name"/></DockPanel>
<ComboBox Grid.Row="1" ItemsSource="{Binding Theses}" SelectedItem="{Binding Selected}" DisplayMemberPath="Label" Margin="0,0,0,12"/>
<Border Grid.Row="2" Style="{StaticResource Card}" Padding="14" Margin="0,0,0,12"><StackPanel><DockPanel><Border Style="{StaticResource ThesisSignal}" DataContext="{Binding Selected}" Margin="0,2,10,0"/><TextBlock Text="{Binding Selected.Status}" FontWeight="Bold" FontSize="17"/><TextBlock Text="{Binding ReviewNotice}" HorizontalAlignment="Right" FontWeight="SemiBold"/></DockPanel><TextBlock Text="{Binding Selected.ConditionNotice}" Margin="0,8,0,0"/></StackPanel></Border>
<TabControl Grid.Row="3" IsEnabled="{Binding HasThesis}">
<TabItem Header="投资逻辑"><DockPanel Margin="16"><WrapPanel DockPanel.Dock="Top" Margin="0,0,0,12"><Button Content="编辑观点 / 日期" Command="{Binding EditCommand}" IsEnabled="{Binding CanEdit}" Margin="0,0,10,8"/><Button Content="用户确认状态" Command="{Binding StatusCommand}" IsEnabled="{Binding CanChangeStatus}" Margin="0,0,10,8"/><Button Content="完成复盘" Command="{Binding ReviewCommand}" IsEnabled="{Binding CanEdit}" Margin="0,0,10,8"/><Button Content="归档历史" Command="{Binding ArchiveCommand}" IsEnabled="{Binding CanArchive}" Margin="0,0,0,8"/></WrapPanel><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel><Border Style="{StaticResource Card}" Padding="18"><StackPanel><TextBlock Text="投资逻辑 · Investment Summary" FontWeight="Bold" Margin="0,0,0,10"/><TextBlock Text="{Binding Selected.Content.InvestmentSummary}" TextWrapping="Wrap"/></StackPanel></Border>
<Border Style="{StaticResource Card}" Padding="18"><StackPanel><TextBlock Text="市场可能错在哪里" FontWeight="Bold" Margin="0,0,0,10"/><TextBlock Text="{Binding Selected.Content.WhyMarketMayBeWrong}" TextWrapping="Wrap"/></StackPanel></Border>
<Border Style="{StaticResource Card}" Padding="18"><StackPanel><TextBlock Text="预期持有期" FontWeight="Bold" Margin="0,0,0,10"/><TextBlock Text="{Binding Selected.Content.ExpectedHoldingPeriod}" TextWrapping="Wrap"/></StackPanel></Border>
<Border Style="{StaticResource Card}" Padding="18"><StackPanel><TextBlock Text="基准情景 · Base Case" FontWeight="Bold" Margin="0,0,0,10"/><TextBlock Text="{Binding Selected.Content.BaseCaseNarrative}" TextWrapping="Wrap"/></StackPanel></Border>
<Border Style="{StaticResource Card}" Padding="18"><StackPanel><TextBlock Text="乐观情景 · Bull Case" FontWeight="Bold" Margin="0,0,0,10"/><TextBlock Text="{Binding Selected.Content.BullCaseNarrative}" TextWrapping="Wrap"/></StackPanel></Border>
<Border Style="{StaticResource Card}" Padding="18"><StackPanel><TextBlock Text="悲观情景 · Bear Case" FontWeight="Bold" Margin="0,0,0,10"/><TextBlock Text="{Binding Selected.Content.BearCaseNarrative}" TextWrapping="Wrap"/></StackPanel></Border>
<Border Style="{StaticResource Card}" Padding="18"><StackPanel><TextBlock Text="预期催化剂" FontWeight="Bold" Margin="0,0,0,10"/><TextBlock Text="{Binding Selected.Content.ExpectedCatalysts}" TextWrapping="Wrap"/></StackPanel></Border>
<Border Style="{StaticResource Card}" Padding="18"><StackPanel><TextBlock Text="关键风险" FontWeight="Bold" Margin="0,0,0,10"/><TextBlock Text="{Binding Selected.Content.KeyRisks}" TextWrapping="Wrap"/></StackPanel></Border></StackPanel></ScrollViewer></DockPanel></TabItem>
<TabItem Header="假设 · Assumptions"><ScrollViewer VerticalScrollBarVisibility="Auto"><Grid Margin="16" Height="420"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="2*"/><RowDefinition Height="*"/></Grid.RowDefinitions><WrapPanel><Button Content="新增假设" Command="{Binding AddAssumptionCommand}" IsEnabled="{Binding CanEdit}" Margin="0,0,10,12"/><Button Content="编辑 / 更新当前值" Command="{Binding EditAssumptionCommand}" IsEnabled="{Binding CanEdit}" Margin="0,0,10,12"/><Button Content="删除假设" Command="{Binding DeleteAssumptionCommand}" IsEnabled="{Binding CanEdit}" Margin="0,0,10,12"/></WrapPanel><DataGrid Grid.Row="1" ItemsSource="{Binding Selected.Assumptions}" SelectedItem="{Binding SelectedAssumption}"><DataGrid.Columns><DataGridTextColumn Header="假设" Binding="{Binding Content.Description}" Width="210"/><DataGridTextColumn Header="指标" Binding="{Binding Content.Metric}" Width="120"/><DataGridTextColumn Header="基线" Binding="{Binding Content.Baseline}" Width="80"/><DataGridTextColumn Header="预期" Binding="{Binding Content.ExpectedValue}" Width="80"/><DataGridTextColumn Header="当前" Binding="{Binding Content.CurrentValue}" Width="80"/><DataGridTextColumn Header="单位" Binding="{Binding Content.Unit}" Width="70"/><DataGridTextColumn Header="方向" Binding="{Binding Content.Direction}" Width="110"/><DataGridTextColumn Header="Warning" Binding="{Binding Content.WarningThreshold}" Width="85"/><DataGridTextColumn Header="Kill" Binding="{Binding Content.KillThreshold}" Width="80"/><DataGridTextColumn Header="状态" Binding="{Binding Status}" Width="90"/></DataGrid.Columns></DataGrid><ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Margin="0,14,0,0"><StackPanel><TextBlock Text="{Binding SelectedAssumption.Content.Description}" FontWeight="Bold"/><TextBlock Text="{Binding SelectedAssumption.Content.Evidence}" Margin="0,10,0,0"/><TextBlock Text="{Binding SelectedAssumption.LastReviewedAt, StringFormat=上次核实：{0:yyyy-MM-dd HH:mm} UTC}" Style="{StaticResource Muted}"/><TextBlock Text="假设状态由当前值与阈值计算；Unknown 表示未核实，不代表正常。假设触发不会自动宣布 Thesis 失效。" Style="{StaticResource Muted}" Margin="0,12,0,0"/></StackPanel></ScrollViewer></Grid></ScrollViewer></TabItem>
<TabItem Header="Kill Conditions"><ScrollViewer VerticalScrollBarVisibility="Auto"><Grid Margin="16" Height="420"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="2*"/><RowDefinition Height="*"/></Grid.RowDefinitions><TextBlock Text="全部为关键条件 · 仅用户可修改 · AI 只能建议 · 每次更改都保留历史" Style="{StaticResource Muted}" Margin="0,0,0,12"/><WrapPanel Grid.Row="1"><Button Content="用户新增条件" Command="{Binding AddKillCommand}" IsEnabled="{Binding CanEdit}" Margin="0,0,10,12"/><Button Content="编辑 / 更新当前值" Command="{Binding EditKillCommand}" IsEnabled="{Binding CanEdit}" Margin="0,0,10,12"/><Button Content="用户删除条件" Command="{Binding DeleteKillCommand}" IsEnabled="{Binding CanEdit}" Margin="0,0,10,12"/></WrapPanel><DataGrid Grid.Row="2" ItemsSource="{Binding Selected.KillConditions}" SelectedItem="{Binding SelectedKill}"><DataGrid.Columns><DataGridTextColumn Header="关键条件" Binding="{Binding Content.Title}" Width="210"/><DataGridTextColumn Header="指标" Binding="{Binding Content.Metric}" Width="120"/><DataGridTextColumn Header="当前" Binding="{Binding Content.CurrentValue}" Width="80"/><DataGridTextColumn Header="单位" Binding="{Binding Content.Unit}" Width="70"/><DataGridTextColumn Header="方向" Binding="{Binding Content.Direction}" Width="110"/><DataGridTextColumn Header="Warning" Binding="{Binding Content.WarningThreshold}" Width="85"/><DataGridTextColumn Header="Trigger" Binding="{Binding Content.TriggerThreshold}" Width="85"/><DataGridTextColumn Header="状态" Binding="{Binding Assessment}" Width="110"/></DataGrid.Columns></DataGrid><ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto" Margin="0,14,0,0"><StackPanel><TextBlock Text="{Binding SelectedKill.Content.Description}" FontWeight="Bold"/><TextBlock Text="{Binding SelectedKill.Content.Evidence}" Margin="0,10,0,0"/><TextBlock Text="{Binding SelectedKill.LastReviewedAt, StringFormat=上次核实：{0:yyyy-MM-dd HH:mm} UTC}" Style="{StaticResource Muted}"/><TextBlock Text="上穿：≥ 阈值；下穿：≤ 阈值。缺少当前值显示未评估。移除触发条件后仍需由你确认恢复 Active。" Style="{StaticResource Muted}" Margin="0,12,0,0"/></StackPanel></ScrollViewer></Grid></ScrollViewer></TabItem>
<TabItem Header="版本历史"><ScrollViewer VerticalScrollBarVisibility="Auto"><Grid Margin="16" Height="420"><Grid.RowDefinitions><RowDefinition Height="160"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><DataGrid ItemsSource="{Binding History}" SelectedItem="{Binding SelectedHistory}"><DataGrid.Columns><DataGridTextColumn Header="版本" Binding="{Binding Version}" Width="65"/><DataGridTextColumn Header="修改时间 UTC" Binding="{Binding ChangedAt, StringFormat=yyyy-MM-dd HH:mm:ss}" Width="185"/><DataGridTextColumn Header="操作者" Binding="{Binding Actor}" Width="105"/><DataGridTextColumn Header="修改依据" Binding="{Binding ChangeReason}" Width="*"/></DataGrid.Columns></DataGrid><Grid Grid.Row="1" Margin="0,12"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><TextBlock Text="所选历史快照（只读）" FontWeight="Bold"/><TextBlock Grid.Column="1" Text="当前版本（只读）" FontWeight="Bold"/></Grid><Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><TextBox Text="{Binding HistoryText, Mode=OneWay}" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Margin="0,0,8,0"/><TextBox Grid.Column="1" Text="{Binding CurrentText, Mode=OneWay}" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Margin="8,0,0,0"/></Grid></Grid></ScrollViewer></TabItem>
</TabControl></Grid></UserControl>



