<UserControl x:Class="AIInvestmentWorkbench.App.Views.WatchlistView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:views="clr-namespace:AIInvestmentWorkbench.App.Views">
 <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <StackPanel Margin="0,0,0,20"><WrapPanel><Button Content="＋ 加入观察" Command="{Binding AddCommand}" Margin="0,0,10,12"/><Button Content="编辑阶段 / 优先级" Command="{Binding EditCommand}" Margin="0,0,10,12"/><Button Content="移出清单" Command="{Binding RemoveCommand}" Margin="0,0,10,12"/><Button Content="刷新" Command="{Binding DataContext.RefreshCommand, RelativeSource={RelativeSource AncestorType=Window}}" Margin="0,0,0,12"/></WrapPanel><WrapPanel><TextBlock Text="搜索" VerticalAlignment="Center" Margin="0,0,12,0"/><TextBox Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" Width="260" Margin="0,0,16,0"/><ComboBox ItemsSource="{Binding Filters}" SelectedItem="{Binding Filter}" Width="180"/><TextBlock Text="点击表头排序" Style="{StaticResource Muted}" Margin="16,6,0,0"/></WrapPanel></StackPanel>
  <Border Grid.Row="1" Style="{StaticResource Card}" Padding="16"><StackPanel><TextBlock Text="观察证券 · Thesis 状态与复盘" Style="{StaticResource SectionTitle}"/><views:ThesisReviewView DataContext="{Binding ThesisPanel}"/></StackPanel></Border><DataGrid Grid.Row="2" ItemsSource="{Binding Rows}" SelectedItem="{Binding Selected}" SelectionMode="Single"><DataGrid.Columns><DataGridTextColumn Header="代码" Binding="{Binding Ticker}" Width="95"/><DataGridTextColumn Header="证券" Binding="{Binding CompanyName}" Width="140"/><DataGridTextColumn Header="阶段" Binding="{Binding Stage}" Width="130"/><DataGridTextColumn Header="优先级" Binding="{Binding Priority}" Width="90"/><DataGridTextColumn Header="风险" Binding="{Binding RiskStatus}" Width="85"/><DataGridTextColumn Header="观察理由" Binding="{Binding Reason}" Width="180"/><DataGridTextColumn Header="下一步" Binding="{Binding NextAction}" Width="180"/><DataGridTextColumn Header="研究日期" Binding="{Binding LastResearchDate, StringFormat=yyyy-MM-dd}" Width="115"/><DataGridTextColumn Header="备注" Binding="{Binding Notes}" Width="180"/></DataGrid.Columns></DataGrid>
 </Grid>
</UserControl>

