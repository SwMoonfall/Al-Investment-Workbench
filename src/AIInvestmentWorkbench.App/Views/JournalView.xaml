<UserControl x:Class="AIInvestmentWorkbench.App.Views.JournalView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
<Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
<WrapPanel Margin="0,0,0,12"><Button Content="新增日志" Command="{Binding NewCommand}" Margin="0,0,12,8"/><Button Content="刷新" Command="{Binding RefreshCommand}" Margin="0,0,12,8"/><CheckBox Foreground="{DynamicResource TextBrush}" Content="显示全部历史版本（勾选后刷新）" IsChecked="{Binding ShowHistory}" VerticalAlignment="Center" Margin="0,0,12,8"/></WrapPanel>
<TabControl Grid.Row="1" SelectedIndex="{Binding SelectedTab}">
<TabItem Header="Investment Journal"><Grid Margin="16"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="180"/><RowDefinition Height="*"/></Grid.RowDefinitions><DockPanel><Button Content="追加更正版本" Command="{Binding CorrectCommand}" DockPanel.Dock="Right" Margin="12,0,0,12"/><TextBox Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" ToolTip="搜索证券、动作、理由或备注" Margin="0,0,0,12"/></DockPanel><DataGrid Grid.Row="1" ItemsSource="{Binding Journals}" SelectedItem="{Binding SelectedJournal}"><DataGrid.Columns><DataGridTextColumn Header="日期" Binding="{Binding Journal.Date}" Width="110"/><DataGridTextColumn Header="证券" Binding="{Binding Security}" Width="*"/><DataGridTextColumn Header="动作" Binding="{Binding Journal.Action}" Width="125"/><DataGridTextColumn Header="信心" Binding="{Binding Journal.Confidence}" Width="70"/><DataGridTextColumn Header="版本" Binding="{Binding Journal.Version}" Width="60"/></DataGrid.Columns></DataGrid><TextBox Grid.Row="2" Text="{Binding JournalText, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Margin="0,12,0,0"/></Grid></TabItem>
<TabItem Header="周 / 月 / 季度复盘"><Grid Margin="16"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><WrapPanel><ComboBox ItemsSource="{Binding Kinds}" SelectedItem="{Binding Kind}" Width="145" Margin="0,0,12,12"/><TextBox Text="{Binding Anchor}" Width="145" ToolTip="期间内任意日期 yyyy-MM-dd；自动对应自然周/月/季度" Margin="0,0,12,12"/><ComboBox ItemsSource="{Binding Securities}" SelectedItem="{Binding SelectedSecurity}" DisplayMemberPath="Name" Width="210" ToolTip="仅季度复盘按此证券；周/月复盘为账户" Margin="0,0,12,12"/><Button Content="生成资料预览" Command="{Binding GenerateCommand}" Margin="0,0,12,12"/><Button Content="确认并保存" Command="{Binding SaveReviewCommand}" Margin="0,0,12,12"/></WrapPanel><TextBlock Grid.Row="1" Text="日期格式 yyyy-MM-dd；周按周一开始。季度按所选证券，周/月按当前账户。只有用户确认后保存，未结束期间只能保存草稿。" Style="{StaticResource Muted}" Margin="0,0,0,12"/><TextBox Grid.Row="2" Text="{Binding PreviewText, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/></Grid></TabItem>
<TabItem Header="复盘历史"><DockPanel Margin="16"><StackPanel DockPanel.Dock="Top"><WrapPanel><Button Content="继续 / 修订（刷新资料）" Command="{Binding ContinueCommand}" Margin="0,0,12,12"/><Button Content="AI 辅助分析所选复盘" Command="{Binding ReviewAICommand}" IsEnabled="{Binding CanRunAI}" Margin="0,0,12,12"/><Button Content="导出所选版本" Command="{Binding ExportCommand}" Margin="0,0,12,12"/></WrapPanel><ComboBox ItemsSource="{Binding Reviews}" SelectedItem="{Binding SelectedReview}" DisplayMemberPath="Label" Margin="0,0,0,12"/></StackPanel><TextBox Text="{Binding ReviewText, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/></DockPanel></TabItem>
<TabItem Header="行为统计"><TextBox Margin="16" Text="{Binding Behavior, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/></TabItem>
<TabItem Header="Journal AI Review"><Grid Margin="16"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><WrapPanel><TextBlock Text="日志日期范围" VerticalAlignment="Center" Margin="0,0,12,12"/><TextBox Text="{Binding AIFrom}" Width="140" Margin="0,0,12,12"/><TextBox Text="{Binding AITo}" Width="140" Margin="0,0,12,12"/><Button Content="开始 AI 日志复盘" Command="{Binding JournalAICommand}" IsEnabled="{Binding CanRunAI}" Margin="0,0,12,12"/><Button Content="取消 AI" Command="{Binding CancelAICommand}" IsEnabled="{Binding Busy}" Margin="0,0,12,12"/></WrapPanel><TextBlock Grid.Row="1" Text="发送范围内最近 30 条当前版本日志、持有周期及关联 Thesis / 用户季度结论，可能产生费用。AI 只给独立分析，不覆盖原始记录、不做心理诊断。下方显示当前账户最近 5 条 AI 复盘。" Style="{StaticResource Muted}" Margin="0,0,0,12"/><ComboBox Grid.Row="2" ItemsSource="{Binding AIReviews}" SelectedItem="{Binding SelectedAnalysis}" Margin="0,0,0,12"><ComboBox.ItemTemplate><DataTemplate><TextBlock><Run Text="{Binding CreatedAt, Mode=OneWay, StringFormat=yyyy-MM-dd HH:mm}"/><Run Text=" · "/><Run Text="{Binding AnalysisType, Mode=OneWay}"/><Run Text=" · "/><Run Text="{Binding Status, Mode=OneWay}"/></TextBlock></DataTemplate></ComboBox.ItemTemplate></ComboBox><TextBox Grid.Row="3" Text="{Binding AIText, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/></Grid></TabItem>
</TabControl><TextBlock Grid.Row="2" Text="{Binding Status}" TextWrapping="Wrap" Margin="0,12,0,0"/></Grid></UserControl>

