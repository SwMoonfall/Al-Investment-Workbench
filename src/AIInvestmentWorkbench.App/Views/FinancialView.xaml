<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="AIInvestmentWorkbench.App.Views.FinancialView" xmlns:chart="clr-namespace:AIInvestmentWorkbench.App.Controls">
<Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
<DockPanel Margin="0,0,0,16" IsEnabled="{Binding Import.IsIdle}"><Button DockPanel.Dock="Right" Content="刷新资料" Command="{Binding ReloadCommand}" Margin="12,0,0,0"/><TextBlock Text="研究证券" VerticalAlignment="Center" Margin="0,0,16,0"/><ComboBox ItemsSource="{Binding Securities}" SelectedItem="{Binding SelectedSecurity}" DisplayMemberPath="Name" MinWidth="250"/></DockPanel>
<WrapPanel Grid.Row="1" Margin="0,0,0,14"><TextBlock Text="期间类型" VerticalAlignment="Center" Margin="0,0,8,0"/><ComboBox ItemsSource="{Binding PeriodTypes}" SelectedItem="{Binding SelectedPeriodType}" Width="130" Margin="0,0,20,0"/><TextBlock Text="报告币种" VerticalAlignment="Center" Margin="0,0,8,0"/><ComboBox ItemsSource="{Binding Currencies}" SelectedItem="{Binding SelectedCurrency}" Width="110"/><TextBlock Text="年度 / 季度 / TTM 分开分析，无汇率换算" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="20,0"/></WrapPanel>
<TabControl Grid.Row="2" IsEnabled="{Binding HasSecurity}">
<TabItem Header="指标明细"><Grid Margin="16"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
<WrapPanel><Button Content="新增" Command="{Binding AddCommand}" Margin="0,0,10,12"/><Button Content="编辑所选" Command="{Binding EditCommand}" Margin="0,0,10,12"/><Button Content="删除所选" Command="{Binding DeleteCommand}" Margin="0,0,20,12"/><ComboBox ItemsSource="{Binding Periods}" SelectedItem="{Binding SelectedPeriod}" Width="130" Margin="0,0,10,12"/><TextBox Text="{Binding Query, UpdateSourceTrigger=PropertyChanged}" Width="180" ToolTip="搜索指标英文名或备注" Margin="0,0,0,12"/></WrapPanel>
<DataGrid Grid.Row="1" ItemsSource="{Binding Metrics}" SelectedItem="{Binding SelectedMetric}"><DataGrid.Columns><DataGridTextColumn Header="期间" Binding="{Binding Period}" Width="100"/><DataGridTextColumn Header="指标" Binding="{Binding MetricType}" Width="200"/><DataGridTextColumn Header="值" Binding="{Binding Value, StringFormat=N4}" Width="160"/><DataGridTextColumn Header="币种" Binding="{Binding Currency}" Width="65"/><DataGridCheckBoxColumn Header="估算" Binding="{Binding IsEstimated, Mode=OneWay}" Width="65"/><DataGridTextColumn Header="来源 ID" Binding="{Binding SourceId}" Width="240"/><DataGridTextColumn Header="备注" Binding="{Binding Notes}" Width="220"/></DataGrid.Columns></DataGrid>
<StackPanel Grid.Row="2" Margin="0,12,0,0"><TextBlock Text="比例字段使用小数（0.25 = 25%）；金额使用原币单位，股数使用股。点击表头可排序。" Style="{StaticResource Muted}"/><TextBlock Text="{Binding SelectedMetric.Notes}" MaxHeight="90"/></StackPanel></Grid></TabItem>
<TabItem Header="趋势与公式"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="16">
<TextBlock Text="仅展示非估算值。同一币种、期间类型；优先用基础指标计算，缺少基础值时趋势可采用已录入值。空缺不视为零。" Style="{StaticResource Muted}" Margin="0,0,0,16"/>
<UniformGrid Columns="2"><Border Style="{StaticResource Card}" Padding="16" Margin="0,0,12,12"><StackPanel><TextBlock Text="收入 · 原币" FontWeight="Bold"/><chart:TrendChart Points="{Binding RevenueTrend}" IsPercent="false" Height="170" Stroke="{DynamicResource AccentBrush}" TextBrush="{DynamicResource MutedBrush}"/></StackPanel></Border><Border Style="{StaticResource Card}" Padding="16" Margin="0,0,12,12"><StackPanel><TextBlock Text="毛利率" FontWeight="Bold"/><chart:TrendChart Points="{Binding GrossMarginTrend}" IsPercent="true" Height="170" Stroke="{DynamicResource AccentBrush}" TextBrush="{DynamicResource MutedBrush}"/></StackPanel></Border><Border Style="{StaticResource Card}" Padding="16" Margin="0,0,12,12"><StackPanel><TextBlock Text="营业利润率" FontWeight="Bold"/><chart:TrendChart Points="{Binding OperatingMarginTrend}" IsPercent="true" Height="170" Stroke="{DynamicResource AccentBrush}" TextBrush="{DynamicResource MutedBrush}"/></StackPanel></Border><Border Style="{StaticResource Card}" Padding="16" Margin="0,0,12,12"><StackPanel><TextBlock Text="自由现金流 · 原币" FontWeight="Bold"/><chart:TrendChart Points="{Binding FcfTrend}" IsPercent="false" Height="170" Stroke="{DynamicResource AccentBrush}" TextBrush="{DynamicResource MutedBrush}"/></StackPanel></Border></UniformGrid>
<TextBlock Text="代码计算结果 · 空白表示缺少数据或分母不适用" Style="{StaticResource SectionTitle}"/>
<DataGrid ItemsSource="{Binding Formulas}" Height="230"><DataGrid.Columns><DataGridTextColumn Header="期间" Binding="{Binding Period}" Width="100"/><DataGridTextColumn Header="收入同比" Binding="{Binding RevenueGrowth, StringFormat=P2}" Width="100"/><DataGridTextColumn Header="毛利率" Binding="{Binding GrossMargin, StringFormat=P2}" Width="100"/><DataGridTextColumn Header="营业利润率" Binding="{Binding OperatingMargin, StringFormat=P2}" Width="110"/><DataGridTextColumn Header="计算 FCF" Binding="{Binding FreeCashFlow, StringFormat=N2}" Width="*"/><DataGridTextColumn Header="录入 FCF（供核对）" Binding="{Binding ReportedFreeCashFlow, StringFormat=N2}" Width="*"/></DataGrid.Columns></DataGrid>
<TextBlock Text="FCF = OCF − Capex；毛利率 = GrossProfit / Revenue；营业利润率 = OperatingIncome / Revenue；同比 =（本期 − 上年同期）/ 上年同期。比例分母须为正。" Style="{StaticResource Muted}" Margin="0,12,0,0"/></StackPanel></ScrollViewer></TabItem>
<TabItem Header="会计关注规则"><DockPanel Margin="16"><StackPanel DockPanel.Dock="Top"><Button Content="配置规则阈值" Command="{Binding ConfigureRiskCommand}" HorizontalAlignment="Left" Margin="0,0,0,12"/><TextBlock Text="使用所选期间类型和币种的最新非估算期间。Normal 表示本规则未触发；未评估表示资料不足。提示仅供进一步核实，不是财务造假判断。" Margin="0,0,0,16"/></StackPanel><ScrollViewer VerticalScrollBarVisibility="Auto"><ItemsControl ItemsSource="{Binding Risks}"><ItemsControl.ItemTemplate><DataTemplate><Border Style="{StaticResource Card}" Padding="16"><StackPanel><TextBlock Text="{Binding Rule}" FontWeight="Bold"/><TextBlock Text="{Binding Status}" Margin="0,6"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/><Style.Triggers><DataTrigger Binding="{Binding Status}" Value="HighAttention"><Setter Property="Foreground" Value="{DynamicResource ErrorBrush}"/></DataTrigger><DataTrigger Binding="{Binding Status}" Value="Warning"><Setter Property="FontWeight" Value="Bold"/></DataTrigger><DataTrigger Binding="{Binding Status}" Value="未评估"><Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock><TextBlock Text="{Binding Evidence}" Style="{StaticResource Muted}"/></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer></DockPanel></TabItem>
<TabItem Header="财务 CSV 导入"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="16" DataContext="{Binding Import}" IsEnabled="{Binding IsIdle}">
<WrapPanel><Button Content="选择财务 CSV" Command="{Binding SelectCommand}" Margin="0,0,12,12"/><Button Content="验证整批" Command="{Binding ValidateCommand}" Margin="0,0,12,12"/><Button Content="确认导入" Command="{Binding CommitCommand}" IsEnabled="{Binding CanImport}" Margin="0,0,12,12"/><Button Content="保存报告" Command="{Binding ReportCommand}" Margin="0,0,12,12"/></WrapPanel>
<TextBlock Text="{Binding FileName}" Margin="0,0,0,12"/><TextBlock Text="仅新增，不覆盖；每行关联顶部所选证券。比例填写 0.25 表示 25%；金额不缩放。空白来源可留空。任何验证失败均不写入。" Style="{StaticResource Muted}" Margin="0,0,0,12"/>
<DataGrid ItemsSource="{Binding Preview}" AutoGenerateColumns="True" Height="180"/>
<ItemsControl ItemsSource="{Binding Mappings}" Margin="0,16"><ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="2"/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><Grid Margin="0,0,20,12"><Grid.ColumnDefinitions><ColumnDefinition Width="120"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Label}" VerticalAlignment="Center"/><ComboBox Grid.Column="1" ItemsSource="{Binding Headers}" SelectedItem="{Binding Header}"/></Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
<TextBox Text="{Binding Report, Mode=OneWay}" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="100"/></StackPanel></ScrollViewer></TabItem></TabControl></Grid></UserControl>


