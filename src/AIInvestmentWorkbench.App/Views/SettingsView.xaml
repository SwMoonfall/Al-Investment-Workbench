<UserControl x:Class="AIInvestmentWorkbench.App.Views.SettingsView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:views="clr-namespace:AIInvestmentWorkbench.App.Views" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
  <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="工作台外观" Style="{StaticResource SectionTitle}"/><TextBlock Text="选择适合当前环境的主题，即时生效并自动保存。" Style="{StaticResource Muted}"/><StackPanel Orientation="Horizontal" Margin="0,22,0,16"><Button Content="浅色 Light" Command="{Binding ChangeThemeCommand}" CommandParameter="Light" AutomationProperties.AutomationId="ThemeLight" Margin="0,0,12,0" MinWidth="140"/><Button Content="深色 Dark" Command="{Binding ChangeThemeCommand}" CommandParameter="Dark" AutomationProperties.AutomationId="ThemeDark" MinWidth="140"/></StackPanel><TextBlock Text="{Binding SelectedTheme, StringFormat=当前主题：{0}}" Foreground="{DynamicResource AccentBrush}" Margin="0,0,0,8"/><TextBlock Text="{Binding Status}" Style="{StaticResource Muted}"/></StackPanel></Border>
  <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="本地数据" Style="{StaticResource SectionTitle}"/><TextBlock Text="数据库位置" Style="{StaticResource Muted}" Margin="0,0,0,8"/><TextBox Text="{Binding DatabasePath, Mode=OneWay}" IsReadOnly="True" AutomationProperties.AutomationId="DatabasePath"/><TextBlock Text="日志目录" Style="{StaticResource Muted}" Margin="0,18,0,8"/><TextBox Text="{Binding LogsPath, Mode=OneWay}" IsReadOnly="True"/><TextBlock Text="数据库保存在当前 Windows 用户目录。日志不记录密码、API Key 或研究内容。" Style="{StaticResource Muted}" FontSize="12" Margin="0,16,0,0"/></StackPanel></Border>
  <StackPanel DataContext="{Binding Maintenance}">
   <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="备份与恢复" Style="{StaticResource SectionTitle}"/><TextBlock Text="{Binding AutomaticStatus}" Style="{StaticResource Muted}"/><TextBox Text="{Binding BackupsPath, Mode=OneWay}" IsReadOnly="True" AutomationProperties.Name="备份目录" Margin="0,12"/><WrapPanel><Button Content="立即备份" Command="{Binding BackupCommand}" Margin="0,0,12,12"/><Button Content="打开备份目录" Command="{Binding OpenBackupCommand}" Margin="0,0,12,12"/><Button Content="从备份恢复…" Command="{Binding RestoreCommand}" Margin="0,0,12,12"/></WrapPanel><TextBlock Text="每日最多一次自动备份，保留最近 7 份。恢复在重启时执行，先保留当前数据库副本。外部附件和密钥不在数据库备份内。" Style="{StaticResource Muted}"/></StackPanel></Border>
   <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="导出资料" Style="{StaticResource SectionTitle}"/><TextBlock Text="Portfolio / Transactions / Journal / Quarterly Review 按当前账户；财务指标可按证券或全部导出。Research / Thesis 需选择证券。Journal 包含全部历史版本。" Style="{StaticResource Muted}"/><WrapPanel Margin="0,12,0,0"><ComboBox ItemsSource="{Binding Kinds}" SelectedItem="{Binding Kind}" Width="240" AutomationProperties.Name="导出类型" Margin="0,0,12,12"/><ComboBox ItemsSource="{Binding Securities}" SelectedItem="{Binding SelectedSecurity}" DisplayMemberPath="Name" Width="220" AutomationProperties.Name="导出证券，可留空" Margin="0,0,12,12"/><Button Content="导出…" Command="{Binding ExportCommand}" Margin="0,0,12,12"/></WrapPanel></StackPanel></Border>
   <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="DEMO · 独立演示工作空间" Style="{StaticResource SectionTitle}"/><TextBlock Text="虚构证券、成交与报价，不是实时行情。Demo 数据库与正式数据库分离。请在正式窗口管理已关闭的 Demo。" Style="{StaticResource Muted}"/><WrapPanel Margin="0,12,0,0" IsEnabled="{Binding DemoAllowed}"><Button Content="创建 / 打开 Demo" Command="{Binding DemoCommand}" Margin="0,0,12,12"/><Button Content="Reset Demo Data" Command="{Binding ResetDemoCommand}" Margin="0,0,12,12"/><Button Content="Delete Demo Data" Command="{Binding DeleteDemoCommand}" Margin="0,0,12,12"/></WrapPanel></StackPanel></Border>
   <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="关于" Style="{StaticResource SectionTitle}"/><TextBlock Text="{Binding About}"/><TextBlock Text="{Binding Status}" TextWrapping="Wrap" Margin="0,12,0,0"/></StackPanel></Border>
  </StackPanel>
  <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="AI Provider 状态" Style="{StaticResource SectionTitle}"/><TextBlock Text="{Binding AI.Provider}"/><TextBlock Text="AI 是可选的研究增强层。当前版本不提供券商连接和自动交易。" Style="{StaticResource Muted}" Margin="0,8,0,0"/></StackPanel></Border>
 </StackPanel></ScrollViewer>
</UserControl>
